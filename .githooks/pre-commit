#!/usr/bin/env bash
set -euo pipefail

if ! command -v nix >/dev/null 2>&1; then
  echo "pre-commit: nix not found; install Nix to run formatting." >&2
  exit 1
fi

echo "pre-commit: running nix fmt"
nix fmt . --extra-experimental-features nix-command --extra-experimental-features flakes
git add -u
