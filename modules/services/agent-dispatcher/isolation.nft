# Zero-trust egress for the agent microVM bridge.
#
# Loaded as its own table next to homelab's regular (iptables) firewall.
# Netfilter runs every table's base chains for a hook, and a drop in any of
# them is final, so nothing below can be "opened up" by another ruleset.
# Watch it work: sudo nft list table inet agent-isolation   (counters!)

table inet agent-isolation
delete table inet agent-isolation

table inet agent-isolation {
  set blocked_v4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8,       # "this" network
      10.0.0.0/8,      # RFC1918 (includes the bridge itself)
      100.64.0.0/10,   # CGNAT / Tailscale tailnet
      127.0.0.0/8,     # loopback
      169.254.0.0/16,  # link-local / cloud metadata
      172.16.0.0/12,   # RFC1918 (docker etc.)
      192.168.0.0/16,  # RFC1918 (home LAN)
      224.0.0.0/4,     # multicast
      240.0.0.0/4      # reserved / broadcast
    }
  }

  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname "br-agent" counter drop comment "VM -> host: never (no DNS, no SSH, no Caddy)"
  }

  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    iifname "br-agent" meta nfproto ipv6 counter drop comment "VM -> IPv6: not offered"
    iifname "br-agent" ip daddr @blocked_v4 counter drop comment "VM -> LAN / tailnet / private"
    iifname "br-agent" ip daddr { 1.1.1.1, 9.9.9.9 } meta l4proto { tcp, udp } th dport 53 counter accept comment "VM -> public DNS"
    iifname "br-agent" tcp dport { 22, 80, 443 } counter accept comment "VM -> git, http(s)"
    iifname "br-agent" udp dport 123 counter accept comment "VM -> NTP"
    iifname "br-agent" counter drop comment "VM -> anything else"
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.240.0.0/24 oifname != "br-agent" counter masquerade comment "VM shares the host's public IP"
  }
}
